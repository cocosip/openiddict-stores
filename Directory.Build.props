<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <!-- CI builds and packs once, then publishes that artifact, so the CI normalization must happen at
         build time rather than only on the pack command. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Only src/ projects are packable; tests and samples must never enter a package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Sharp.OpenIddict.Stores</Product>
    <Company>Sharp.OpenIddict.Stores</Company>
    <Authors>Sharp.OpenIddict.Stores contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.0.0</VersionPrefix>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
