<Project>

  <!--
    Single version source for central package management: no project may declare its own
    Version attribute (design 4.1). All dependencies are stable releases; no preview
    packages are referenced (design 2, design 3).

    Versions are bounded ranges instead of exact pins. Central package management still
    restores the lowest version in a range, so the build uses the reviewed lower bound,
    while the packed nuspec carries the range and lets a consumer take compatible
    servicing updates inside the same major line. Lower bounds are the lowest patches that
    already carry the security fixes this repository ships.
  -->
  <PropertyGroup>
    <OpenIddictVersionRange>[7.7.2,8.0.0)</OpenIddictVersionRange>
  </PropertyGroup>

  <!--
    One version line per target framework (design 4.1.1): netstandard2.0/2.1 and net8.0
    stay on the 8.0.x line, net9.0 on 9.0.x and net10.0 on 10.0.x. Every Microsoft
    package below reuses the property, so a line is bumped in exactly one place.
  -->
  <PropertyGroup>
    <MicrosoftVersionRange>[10.0.13,11.0.0)</MicrosoftVersionRange>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftVersionRange>[9.0.21,10.0.0)</MicrosoftVersionRange>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1' Or '$(TargetFramework)' == 'net8.0'">
    <MicrosoftVersionRange>[8.0.2,9.0.0)</MicrosoftVersionRange>
  </PropertyGroup>

  <!--
    The OpenIddict packages move together: one range covers the runtime packages and the
    transitive Abstractions pin, so a 8.x upgrade is a single property change.
  -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Abstractions" Version="$(OpenIddictVersionRange)" />
    <PackageVersion Include="OpenIddict.Core" Version="$(OpenIddictVersionRange)" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="$(OpenIddictVersionRange)" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="$(OpenIddictVersionRange)" />
    <PackageVersion Include="OpenIddict.Client.AspNetCore" Version="$(OpenIddictVersionRange)" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.* and the transitive System.Security.Cryptography.Pkcs pin share
    the per-TFM line above. Pkcs 8.0.2 carries the GHSA-2fmv-rv2c-59x7 /
    GHSA-846f-f764-76mx fixes, so it is also the 8.x lower bound.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftVersionRange)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftVersionRange)" />
  </ItemGroup>

  <!--
    Tests, samples and tooling target net10.0 only and never enter a package, so their
    versions stay pinned: the test runner and database drivers are sensitive to the exact
    SDK/driver pair, and nothing here is published as a dependency.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageVersion Include="DM.DmProvider" Version="8.3.1.47463" />
  </ItemGroup>

</Project>
