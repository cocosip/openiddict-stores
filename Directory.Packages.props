<Project>

  <!--
    Single version source for central package management: no project may declare its own
    Version attribute (design 4.1). All dependencies are stable releases; no preview
    packages are referenced (design 2, design 3).
  -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Core" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Client.AspNetCore" Version="7.7.2" />
  </ItemGroup>

  <!--
    Per-TFM Microsoft.Extensions.* version lines (design 4.1.1). Each target framework
    takes the version line of its own generation and never goes below the floor required
    by the matching OpenIddict 7.7.2 dependency group, so net10-era packages are never
    fed to netstandard or net8 assets.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1' Or '$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- 8.0.2 stays on the 8.0.x line (design 4.1.1) and carries the GHSA-2fmv-rv2c-59x7/GHSA-846f-f764-76mx fixes. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.21" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Tests, samples and tooling target net10.0 only and use 10.0.x (design 4.1.1). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageVersion Include="DM.DmProvider" Version="8.3.1.47463" />
  </ItemGroup>

</Project>
