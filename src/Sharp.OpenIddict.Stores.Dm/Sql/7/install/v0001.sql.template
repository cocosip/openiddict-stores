-- Sharp.OpenIddict.Stores — Dameng DM8 (native mode) install script TEMPLATE
-- This file is not executable as-is: the prefix and schema placeholders must be rendered first (see Sql/README.md).
-- Target: Dameng DM8 with COMPATIBLE_MODE set to the NATIVE mode, installed into a dedicated schema.
--   DM8 supports several compatibility modes and they differ in string comparison, empty-string handling,
--   paging syntax, and DDL. This script and its manifest entry declare native mode only; running it against an
--   Oracle- or MySQL-compatible instance is NOT covered by that declaration and needs its own entry and
--   acceptance run (design 5, 10.1).
-- Source version: none (install script); target: Series 7 / Version 1.
-- Transaction boundary: this script has NO surrounding transaction. DM8 commits DDL implicitly, so a failure
--   part-way leaves the objects already created in place. Diagnose with the data dictionary and the version
--   record, then finish or drop the partial objects manually before re-running (design 10.3, 17).
-- Client separators: no "/", no "GO", no PL/SQL block. Each statement ends with a semicolon, so DISQL, a
--   migration manager, and an ADO.NET command loop can all execute the rendered copy after splitting on ";".
-- Identifiers: always double-quoted. DM8 folds unquoted names to upper case, while the runtime quotes every
--   table and column name, so unquoted DDL would create OPENIDDICTAPPLICATIONS. The schema placeholder becomes
--   the quoted schema plus its dot, or nothing.
-- Exact comparisons: the runtime emits a plain equality. Whether DM8 compares VARCHAR case-, accent-, and
--   trailing-space-sensitively depends on the instance character set and the compatibility mode, and that is
--   listed as a release blocker in Sql/README.md rather than assumed here (design 16.1.1).
-- Deletion: every foreign key is NO ACTION; the Store performs the associated deletes explicitly.

CREATE TABLE __SCHEMA__"__PREFIX__Applications" (
    "Id" nvarchar(100) NOT NULL,
    "ConcurrencyToken" nvarchar(50) NOT NULL,
    "ApplicationType" nvarchar(50) NULL,
    "ClientId" nvarchar(100) NULL,
    "ClientSecret" clob NULL,
    "ClientType" nvarchar(50) NULL,
    "ConsentType" nvarchar(50) NULL,
    "DisplayName" clob NULL,
    "DisplayNames" clob NULL,
    "JsonWebKeySet" clob NULL,
    "Permissions" clob NULL,
    "PostLogoutRedirectUris" clob NULL,
    "Properties" clob NULL,
    "RedirectUris" clob NULL,
    "Requirements" clob NULL,
    "Settings" clob NULL,
    CONSTRAINT "PK___PREFIX__Applications" PRIMARY KEY ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__Authorizations" (
    "Id" nvarchar(100) NOT NULL,
    "ConcurrencyToken" nvarchar(50) NOT NULL,
    "ApplicationId" nvarchar(100) NULL,
    "CreationDate" timestamp(6) NULL,
    "Properties" clob NULL,
    "Scopes" clob NULL,
    "Status" nvarchar(50) NULL,
    "Subject" nvarchar(400) NULL,
    "Type" nvarchar(50) NULL,
    CONSTRAINT "PK___PREFIX__Authorizations" PRIMARY KEY ("Id"),
    CONSTRAINT "FK___PREFIX__Authorizations_App" FOREIGN KEY ("ApplicationId")
        REFERENCES __SCHEMA__"__PREFIX__Applications" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__Scopes" (
    "Id" nvarchar(100) NOT NULL,
    "ConcurrencyToken" nvarchar(50) NOT NULL,
    "Description" clob NULL,
    "Descriptions" clob NULL,
    "DisplayName" clob NULL,
    "DisplayNames" clob NULL,
    "Name" nvarchar(200) NULL,
    "Properties" clob NULL,
    "Resources" clob NULL,
    CONSTRAINT "PK___PREFIX__Scopes" PRIMARY KEY ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__Tokens" (
    "Id" nvarchar(100) NOT NULL,
    "ConcurrencyToken" nvarchar(50) NOT NULL,
    "ApplicationId" nvarchar(100) NULL,
    "AuthorizationId" nvarchar(100) NULL,
    "CreationDate" timestamp(6) NULL,
    "ExpirationDate" timestamp(6) NULL,
    "Payload" clob NULL,
    "Properties" clob NULL,
    "RedemptionDate" timestamp(6) NULL,
    "ReferenceId" nvarchar(100) NULL,
    "Status" nvarchar(50) NULL,
    "Subject" nvarchar(400) NULL,
    "Type" nvarchar(150) NULL,
    CONSTRAINT "PK___PREFIX__Tokens" PRIMARY KEY ("Id"),
    CONSTRAINT "FK___PREFIX__Tokens_App" FOREIGN KEY ("ApplicationId")
        REFERENCES __SCHEMA__"__PREFIX__Applications" ("Id"),
    CONSTRAINT "FK___PREFIX__Tokens_Authz" FOREIGN KEY ("AuthorizationId")
        REFERENCES __SCHEMA__"__PREFIX__Authorizations" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__ApplicationRedirectUris" (
    "ApplicationId" nvarchar(100) NOT NULL,
    "UriHash" varbinary(32) NOT NULL,
    "Uri" clob NOT NULL,
    "Position" int NOT NULL,
    CONSTRAINT "PK___PREFIX__AppRedirectUris" PRIMARY KEY ("ApplicationId", "Position"),
    CONSTRAINT "FK___PREFIX__AppRedirectUris_App" FOREIGN KEY ("ApplicationId")
        REFERENCES __SCHEMA__"__PREFIX__Applications" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__ApplicationPostLogoutRedirectUris" (
    "ApplicationId" nvarchar(100) NOT NULL,
    "UriHash" varbinary(32) NOT NULL,
    "Uri" clob NOT NULL,
    "Position" int NOT NULL,
    CONSTRAINT "PK___PREFIX__AppPostLogoutUris" PRIMARY KEY ("ApplicationId", "Position"),
    CONSTRAINT "FK___PREFIX__AppPostLogoutUris_App" FOREIGN KEY ("ApplicationId")
        REFERENCES __SCHEMA__"__PREFIX__Applications" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__AuthorizationScopes" (
    "AuthorizationId" nvarchar(100) NOT NULL,
    "ScopeHash" varbinary(32) NOT NULL,
    "Scope" clob NOT NULL,
    "Position" int NOT NULL,
    CONSTRAINT "PK___PREFIX__AuthScopes" PRIMARY KEY ("AuthorizationId", "Position"),
    CONSTRAINT "FK___PREFIX__AuthScopes_Authz" FOREIGN KEY ("AuthorizationId")
        REFERENCES __SCHEMA__"__PREFIX__Authorizations" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__ScopeResources" (
    "ScopeId" nvarchar(100) NOT NULL,
    "ResourceHash" varbinary(32) NOT NULL,
    "Resource" clob NOT NULL,
    "Position" int NOT NULL,
    CONSTRAINT "PK___PREFIX__ScopeResources" PRIMARY KEY ("ScopeId", "Position"),
    CONSTRAINT "FK___PREFIX__ScopeResources_Scope" FOREIGN KEY ("ScopeId")
        REFERENCES __SCHEMA__"__PREFIX__Scopes" ("Id")
);

CREATE TABLE __SCHEMA__"__PREFIX__SchemaVersions" (
    "Series" nvarchar(10) NOT NULL,
    "Version" int NOT NULL,
    "UpdatedUtc" timestamp(6) NOT NULL,
    CONSTRAINT "PK___PREFIX__SchemaVersions" PRIMARY KEY ("Series")
);

-- Unique keys: DM8 treats NULLs as distinct in a unique index, so many NULL ClientId/Name/ReferenceId values
-- are allowed without a workaround (design 7, 15.4).
CREATE UNIQUE INDEX __SCHEMA__"UK___PREFIX__Applications_ClientId"
    ON __SCHEMA__"__PREFIX__Applications" ("ClientId");
CREATE UNIQUE INDEX __SCHEMA__"UK___PREFIX__Scopes_Name"
    ON __SCHEMA__"__PREFIX__Scopes" ("Name");
CREATE UNIQUE INDEX __SCHEMA__"UK___PREFIX__Tokens_ReferenceId"
    ON __SCHEMA__"__PREFIX__Tokens" ("ReferenceId");

-- Main table indexes (design 15.4).
CREATE INDEX __SCHEMA__"IX___PREFIX__Authz_App_Status_Subj_Type"
    ON __SCHEMA__"__PREFIX__Authorizations" ("ApplicationId", "Status", "Subject", "Type");
CREATE INDEX __SCHEMA__"IX___PREFIX__Authorizations_Subject"
    ON __SCHEMA__"__PREFIX__Authorizations" ("Subject");
CREATE INDEX __SCHEMA__"IX___PREFIX__Authorizations_CreationDate"
    ON __SCHEMA__"__PREFIX__Authorizations" ("CreationDate");

CREATE INDEX __SCHEMA__"IX___PREFIX__Token_App_Status_Subj_Type"
    ON __SCHEMA__"__PREFIX__Tokens" ("ApplicationId", "Status", "Subject", "Type");
CREATE INDEX __SCHEMA__"IX___PREFIX__Tokens_AuthorizationId"
    ON __SCHEMA__"__PREFIX__Tokens" ("AuthorizationId");
CREATE INDEX __SCHEMA__"IX___PREFIX__Tokens_Subject" ON __SCHEMA__"__PREFIX__Tokens" ("Subject");
CREATE INDEX __SCHEMA__"IX___PREFIX__Tokens_CreationDate" ON __SCHEMA__"__PREFIX__Tokens" ("CreationDate");
CREATE INDEX __SCHEMA__"IX___PREFIX__Tokens_ExpirationDate" ON __SCHEMA__"__PREFIX__Tokens" ("ExpirationDate");

-- Auxiliary table candidate indexes: hashes only narrow the candidates, the final check uses the full value with Ordinal comparison (design 15.3).
CREATE INDEX __SCHEMA__"IX___PREFIX__AppRedirectUris_Hash"
    ON __SCHEMA__"__PREFIX__ApplicationRedirectUris" ("UriHash", "ApplicationId");
CREATE INDEX __SCHEMA__"IX___PREFIX__AppPostLogoutUris_Hash"
    ON __SCHEMA__"__PREFIX__ApplicationPostLogoutRedirectUris" ("UriHash", "ApplicationId");
CREATE INDEX __SCHEMA__"IX___PREFIX__AuthScopes_ScopeHash"
    ON __SCHEMA__"__PREFIX__AuthorizationScopes" ("ScopeHash", "AuthorizationId");
CREATE INDEX __SCHEMA__"IX___PREFIX__ScopeResources_Hash"
    ON __SCHEMA__"__PREFIX__ScopeResources" ("ResourceHash", "ScopeId");

INSERT INTO __SCHEMA__"__PREFIX__SchemaVersions" ("Series", "Version", "UpdatedUtc")
VALUES ('7', 1, SYS_EXTRACT_UTC(SYSTIMESTAMP));
