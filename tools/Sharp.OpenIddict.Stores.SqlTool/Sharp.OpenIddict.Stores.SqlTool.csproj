<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A repository utility, not one of the eight shipped packages (design 4): it renders the SQL that the
         packages ship as templates. Pack stays at exactly eight artifacts. -->
    <IsPackable>false</IsPackable>
    <Description>Generates deployment SQL for Sharp.OpenIddict.Stores: selects the provider's template, applies the compatibility mode (Dameng), and renders the configured table prefix and schema.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores\Sharp.OpenIddict.Stores.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Dm\Sharp.OpenIddict.Stores.Dm.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.MySql\Sharp.OpenIddict.Stores.MySql.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Oracle\Sharp.OpenIddict.Stores.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.PostgreSql\Sharp.OpenIddict.Stores.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Sqlite\Sharp.OpenIddict.Stores.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.SqlServer\Sharp.OpenIddict.Stores.SqlServer.csproj" />
  </ItemGroup>

  <!-- The templates the packages ship as content, embedded here so the tool is self-contained: it renders
       exactly the bytes whose digests the manifests record, not a private copy that can drift. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.Dm\Sql\**\*" LinkBase="Sql\Dm" />
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.MySql\Sql\**\*" LinkBase="Sql\MySql" />
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.Oracle\Sql\**\*" LinkBase="Sql\Oracle" />
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.PostgreSql\Sql\**\*" LinkBase="Sql\PostgreSql" />
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.Sqlite\Sql\**\*" LinkBase="Sql\Sqlite" />
    <EmbeddedResource Include="..\..\src\Sharp.OpenIddict.Stores.SqlServer\Sql\**\*" LinkBase="Sql\SqlServer" />
  </ItemGroup>

</Project>
