<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Description>Store contract and integration tests on SQLite temporary files. Real-server acceptance lives in Sharp.OpenIddict.Stores.ServerAcceptanceTests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <!-- SQLite only: this project needs no server. Oracle stays for the parameter-binding contract, which checks
       driver-specific binding without connecting to anything. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores\Sharp.OpenIddict.Stores.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Models\Sharp.OpenIddict.Stores.Models.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.SqlServer\Sharp.OpenIddict.Stores.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.PostgreSql\Sharp.OpenIddict.Stores.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.MySql\Sharp.OpenIddict.Stores.MySql.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Sqlite\Sharp.OpenIddict.Stores.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Oracle\Sharp.OpenIddict.Stores.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Dm\Sharp.OpenIddict.Stores.Dm.csproj" />
  </ItemGroup>
</Project>