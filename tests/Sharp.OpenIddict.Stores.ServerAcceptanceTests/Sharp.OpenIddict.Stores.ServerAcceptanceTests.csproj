<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone real-server acceptance harness. Deliberately NOT part of Sharp.OpenIddict.Stores.slnx and
    never touched by CI: it runs only when invoked explicitly, and only after connection strings have been
    placed in the dotnet user-secrets store (id OpenIddictStoresServerAcceptance). Nothing here is a unit
    test; with no secrets configured every fact reports itself as skipped with the reason.
    Packages come from the central Directory.Packages.props like every other project in the repository.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Description>Real-server acceptance runs for PostgreSQL, Oracle, and DM8, configured through user-secrets and executed explicitly.</Description>
    <UserSecretsId>OpenIddictStoresServerAcceptance</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-box secrets reader resolves the store through this metadata; the dotnet CLI writes the
         secrets.json next to it under the user profile. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UserSecretsId</_Parameter1>
      <_Parameter2>$(UserSecretsId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <!-- Only the drivers the configured servers need; none of these flow into any shipped package. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="DM.DmProvider" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores\Sharp.OpenIddict.Stores.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Models\Sharp.OpenIddict.Stores.Models.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.PostgreSql\Sharp.OpenIddict.Stores.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Oracle\Sharp.OpenIddict.Stores.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Sharp.OpenIddict.Stores.Dm\Sharp.OpenIddict.Stores.Dm.csproj" />
  </ItemGroup>
</Project>
